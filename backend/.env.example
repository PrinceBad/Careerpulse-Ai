# SerpApi Credentials
# Get your API key from https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# LLM Configuration (Pluggable)
# Supported providers: "mock" (offline fallback), "gemini", "openai"
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cache Settings (1 = Enable disk caching to save SerpApi credits & guarantee demo stability)
SERPAPI_CACHE_ENABLED=1
SERPAPI_CACHE_DIR=./cache

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
